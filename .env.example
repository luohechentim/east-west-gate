# Copy this file to .env locally if your shell tooling loads dotenv files.
# Never commit a real API key. The library itself only reads process environment.

# Default OpenAI-compatible endpoint used when a panel member does not provide
# its own base_url / api_key_env settings.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional panel override. Keep API keys in the environment variables named by
# api_key_env; do not place secret values in this JSON.
#
# DOUBLE_GATE_PANELS_JSON={"deep":{"description":"two-provider panel","models":[{"vendor":"openai_compatible","provider":"provider-a","base_url":"https://provider-a.example/v1","api_key_env":"PROVIDER_A_API_KEY","model":"model-a","role":"primary"},{"vendor":"openai_compatible","provider":"provider-b","base_url":"https://provider-b.example/v1","api_key_env":"PROVIDER_B_API_KEY","model":"model-b","role":"critic"}]}}
PROVIDER_A_API_KEY=
PROVIDER_B_API_KEY=
